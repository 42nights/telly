# Fetch.ai worker (main.py) and bridge (bridge.py). See README.md.
# Load with: bunx varlock run --path agents/fetch -- .venv/bin/python main.py
# @defaultRequired=false
# @defaultSensitive=true
# ---

# --- Worker (main.py) ---

# Seed for the worker agent identity; the same seed gives the same agent address.
# Generate one: openssl rand -hex 32. Required for the worker.
TELLY_FETCH_AGENT_SEED=

# http(s) base URL of the telly server. Required for the worker.
# @public @type=url
TELLY_SERVER_URL=

# The worker's OIDC token for the server, from OIDC_ISSUER (issue #4). Its identity must be a
# member of each granted family. Tokens expire; renew before expiry. Required for the worker.
TELLY_FETCH_SERVER_TOKEN=

# JSON: sender agent address -> list of family ids, such as {"agent1q...": ["12"]}.
# Give a chat sender only a synthetic demo family. Required for the worker.
# @public
TELLY_FETCH_GRANTS=

# @public @type=port
TELLY_FETCH_PORT=8001

# true: use an Agentverse mailbox (needs Agentverse access). false: local tests only.
# @public @type=enum(true, false) @docs(https://agentverse.ai)
TELLY_FETCH_MAILBOX=true

# --- Bridge (bridge.py) ---

# Seed for the bridge agent identity. Put its address in the worker's TELLY_FETCH_GRANTS.
# Generate one: openssl rand -hex 32. Required for the bridge.
TELLY_FETCH_BRIDGE_SEED=

# Shared secret between the server and the bridge; the same value as the server's
# TELLY_FETCH_BRIDGE_TOKEN. Generate one: openssl rand -hex 32. Required for the bridge.
TELLY_FETCH_BRIDGE_TOKEN=

# The worker's agent address (agent1...). Required for the bridge.
# @public
TELLY_FETCH_WORKER_ADDRESS=

# The server's TELLY_FETCH_BRIDGE_URL points here.
# @public @type=port
TELLY_FETCH_BRIDGE_PORT=8002

# The worker's local /submit URL. Only with TELLY_FETCH_MAILBOX=false.
# @public @type=url
TELLY_FETCH_WORKER_ENDPOINT=
