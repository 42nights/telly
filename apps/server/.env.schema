# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
CORS_ORIGIN=http://localhost:3001

# @public
HOST=127.0.0.1

# @public @type=port
PORT=3000

# Server-only ElevenLabs key for voice transcription and speech. Unset: voice routes reply 503 `unavailable`.
# @optional @docs(https://elevenlabs.io/docs/api-reference/authentication)
ELEVENLABS_API_KEY=

# ElevenLabs voice for spoken replies. The default is the premade voice "George".
# @public
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
