# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
CORS_ORIGIN=http://localhost:3001

# @public
HOST=127.0.0.1

# @public @type=port
PORT=3000

# Sign-in: set all four, or none. With none, every protected route answers `unavailable` (503).
# Production uses Google: OIDC_ISSUER=https://accounts.google.com, and OIDC_AUDIENCE is the Google
# OAuth web client ID (the shared TELLY_OIDC_CLIENT_ID). Web and phone use the same client ID.

# Trusted OIDC issuer; tokens must carry exactly this `iss`.
# @public @required=false
OIDC_ISSUER=

# This API's OIDC client id; tokens must list it in `aud`.
# @public @required=false
OIDC_AUDIENCE=

# The client secret of that client (the shared TELLY_OIDC_CLIENT_SECRET). `POST /api/sign-in/token`
# adds it to the code exchange; Google web clients need it. It never goes to a browser or phone.
# Its client must list `<web origin>/sign-in` and `<this server>/api/sign-in/callback` as redirect URIs.
# @required=false @docs(https://developers.google.com/identity/openid-connect/openid-connect)
OIDC_CLIENT_SECRET=

# SpacetimeDB WebSocket URL, such as ws://127.0.0.1:3000. It must trust OIDC_ISSUER.
# @public @required=false
SPACETIMEDB_URI=

# @public @required=false
SPACETIMEDB_DATABASE=

# Alert delivery: the SpacetimeDB token of the identity that published the module, which the module
# makes the delivery operator. Mint: `spacetime login show --token` as the identity that ran `spacetime publish`.
# Unset: the alert outbox does not run, and deliveries stay queued.
# @required=false @docs(https://spacetimedb.com/docs/cli-reference)
ALERT_OPERATOR_TOKEN=

# Server-only ElevenLabs key for voice transcription and speech. Unset: voice routes reply 503 `unavailable`.
# @required=false @docs(https://elevenlabs.io/docs/api-reference/authentication)
ELEVENLABS_API_KEY=

# ElevenLabs voice for spoken replies. The default is the premade voice "George".
# @public
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ElevenLabs API server: the default, or a data-residency server such as https://api.eu.residency.elevenlabs.io.
# @public @type=url
ELEVENLABS_API_URL=https://api.elevenlabs.io

# Gemini API key for medicine detection, meal estimates, and family questions; server-only. Without
# it, vision, meal estimate, and question routes answer `unavailable`.
# @required=false @docs(https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gemini API origin. Override only for a gateway that serves the same API.
# @public @type=url
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# FinchNode health records: off; demo (the keyless public demo, fictional patients only); or api
# (https://api.finchnode.com/api/v1 with FINCHNODE_API_KEY).
# @public @type=enum(off, demo, api)
FINCHNODE_MODE=off

# Server-only FinchNode key: ck_test_… (sandbox, fictional patients) or ck_live_…. Needed only for api.
# @required=false @docs(https://finchnode.com/docs)
FINCHNODE_API_KEY=

# Fetch.ai Agentverse: set both, or none. With none, agent tool calls answer `unavailable` (503).

# Local bridge uAgent REST base URL; the bridge listens on TELLY_FETCH_BRIDGE_PORT (default http://127.0.0.1:8002).
# @public @type=url @required=false
TELLY_FETCH_BRIDGE_URL=

# Shared secret that the bridge checks on each tool call; the same value as agents/fetch TELLY_FETCH_BRIDGE_TOKEN.
# Generate one: openssl rand -hex 32.
# @required=false
TELLY_FETCH_BRIDGE_TOKEN=

# Photon Spectrum Cloud iMessage: set all three, or none. With none, no iMessage agent runs.

# Spectrum project id from the Photon dashboard.
# @public @required=false
SPECTRUM_PROJECT_ID=

# Spectrum project secret from the Photon dashboard.
# @required=false
SPECTRUM_PROJECT_SECRET=

# Allowed iMessage senders, each mapped to one family: address=familyId pairs separated by commas,
# for example +15551234567=1,grandma@example.com=1. Other senders get no reply.
# @required=false
TELLY_IMESSAGE_SENDERS=

# River deployment of the trained Gemma cue model; see training/README.md. Without all four
# values, the cue route answers `unavailable`.
# @public @required=false @type=url
GEMMA_BASE_URL=

# @public @required=false
GEMMA_DEPLOYMENT=

# @public @required=false
GEMMA_CHECKPOINT=

# River API key that can call the deployment; server-only.
# @required=false @docs(https://console.river.ai/)
RIVER_API_KEY=

# Lab report PDFs in the private Cloudflare R2 bucket `telly-reports`, through the S3 API. Without all
# four values, the PDF routes answer `unavailable` (503). Use an R2 API token with "Object Read &
# Write" for this one bucket only; never make the bucket public. Downloads are short-lived signed links.

# Cloudflare account that owns the bucket.
# @public @required=false @docs(https://developers.cloudflare.com/r2/api/s3/api/)
TELLY_R2_ACCOUNT_ID=

# @public @required=false
TELLY_R2_BUCKET=

# Access key id of the bucket-scoped R2 API token. Not a secret: every presigned link carries it in
# X-Amz-Credential, so it is public here (the varlock leak check would block the links otherwise).
# @public @required=false @docs(https://developers.cloudflare.com/r2/api/tokens/)
TELLY_R2_ACCESS_KEY_ID=

# Secret access key of the same token; server-only.
# @required=false
TELLY_R2_SECRET_ACCESS_KEY=

# Test harness only: an S3-compatible server to use instead of https://<account>.r2.cloudflarestorage.com.
# @public @required=false @type=url
TELLY_R2_ENDPOINT=

# Test harness only. `bun run db:test` sets this to the module publisher's token; leave it empty.
# @required=false
SPACETIMEDB_OPERATOR_TOKEN=

# Test harness only: first port of `bun run db:drill` (the restored server uses the next port).
# @public @required=false @type=port
DRILL_PORT=3600
