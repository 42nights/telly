# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
CORS_ORIGIN=http://localhost:3001

# @public
HOST=127.0.0.1

# @public @type=port
PORT=3000

# Sign-in: set all four, or none. With none, every protected route answers `unavailable` (503).
# The production issuer and audience are not chosen yet (issue #4).

# Trusted OIDC issuer; tokens must carry exactly this `iss`.
# @public @required=false
OIDC_ISSUER=

# This API's OIDC client id; tokens must list it in `aud`.
# @public @required=false
OIDC_AUDIENCE=

# SpacetimeDB WebSocket URL, such as ws://127.0.0.1:3000. It must trust OIDC_ISSUER.
# @public @required=false
SPACETIMEDB_URI=

# @public @required=false
SPACETIMEDB_DATABASE=

# Alert delivery: the SpacetimeDB token of the identity that published the module, which the module
# makes the delivery operator. Unset: the alert outbox does not run, and deliveries stay queued.
# @required=false
ALERT_OPERATOR_TOKEN=

# Server-only ElevenLabs key for voice transcription and speech. Unset: voice routes reply 503 `unavailable`.
# @required=false @docs(https://elevenlabs.io/docs/api-reference/authentication)
ELEVENLABS_API_KEY=

# ElevenLabs voice for spoken replies. The default is the premade voice "George".
# @public
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ElevenLabs API server: the default, or a data-residency server such as https://api.eu.residency.elevenlabs.io.
# @public @type=url
ELEVENLABS_API_URL=https://api.elevenlabs.io

# Gemini API key for medicine detection; server-only. Without it, vision routes answer `unavailable`.
# @required=false
GEMINI_API_KEY=

# Gemini API origin. Override only for a gateway that serves the same API.
# @public @type=url
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
