# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
EXPO_PUBLIC_SERVER_URL=http://localhost:3000

# Phone sign-in (issue #4). Production: https://accounts.google.com. Unset: the app says sign-in is not set up.
# @public @type=url @required=false
EXPO_PUBLIC_OIDC_ISSUER=

# The same Google OAuth web client ID as the web app (the shared TELLY_OIDC_CLIENT_ID); the server's
# OIDC_AUDIENCE must be this value. The issuer returns to `<EXPO_PUBLIC_SERVER_URL>/api/sign-in/callback`,
# which the client must list as a redirect URI; the server sends the reply on to `health://sign-in`.
# @public @required=false
EXPO_PUBLIC_OIDC_CLIENT_ID=
