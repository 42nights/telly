# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
EXPO_PUBLIC_SERVER_URL=http://localhost:3000

# Phone sign-in (issue #4). The production issuer is not chosen yet. Unset: the app says sign-in is not set up.
# @public @type=url @required=false
EXPO_PUBLIC_OIDC_ISSUER=

# The client id at that issuer. The server's OIDC_AUDIENCE must be this value, and the client must
# allow the redirect `health://sign-in`.
# @public @required=false
EXPO_PUBLIC_OIDC_CLIENT_ID=
