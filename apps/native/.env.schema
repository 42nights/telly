# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Production defaults. For development, override both in an ignored `.env.local`.
# @public @type=url
EXPO_PUBLIC_SERVER_URL=https://api.saintess.tech

# The web app that the shell shows. Only this origin loads in the shell and gets the session.
# @public @type=url
EXPO_PUBLIC_WEB_URL=https://app.saintess.tech

# Phone sign-in (issue #4). Production default: Google. Unset: the app says sign-in is not set up.
# @public @type=url @required=false
EXPO_PUBLIC_OIDC_ISSUER=https://accounts.google.com

# The same Google OAuth web client ID as the web app (the shared TELLY_OIDC_CLIENT_ID, `OIDC_AUDIENCE`
# in deploy/cloudflare/settings.env); the server's OIDC_AUDIENCE must be this value. The issuer returns
# to `<EXPO_PUBLIC_SERVER_URL>/api/sign-in/callback`, which the client must list as a redirect URI; the
# server sends the reply on to `health://sign-in`.
# @public @required=false
EXPO_PUBLIC_OIDC_CLIENT_ID=351092985880-0k4hl1ts8vkrksenpf983ik1qjkgioh0.apps.googleusercontent.com
