# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
VITE_SERVER_URL=http://localhost:3000

# Web sign-in (issue #4). Production: https://accounts.google.com. Unset: the app says sign-in is not set up.
# @public @type=url @required=false
VITE_OIDC_ISSUER=

# The Google OAuth web client ID (the shared TELLY_OIDC_CLIENT_ID). The server's OIDC_AUDIENCE must be
# this value. The client must list `<this web origin>/sign-in` as a redirect URI.
# @public @required=false
VITE_OIDC_CLIENT_ID=
