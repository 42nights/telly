# Public settings of the Cloudflare deployment (deploy/cloudflare/deploy.sh and the web build in
# .github/workflows/health-deploy.yml). No secrets: the API pulls its keys at start.
CLOUDFLARE_ACCOUNT_ID=2c040ec5bc2efe34e60ab5b1b4fd2e99
# The API host. The web app is at https://app.saintess.tech; both hosts are the Worker `telly`.
HEALTH_SERVER_URL=https://api.saintess.tech
# Web origins that call the API: the web app, and the same app at the workers.dev address.
CORS_ORIGIN=https://app.saintess.tech,https://telly.jerry-2c0.workers.dev
# The Worker serves the landing page (deploy/cloudflare/landing/) on this host; www redirects here.
LANDING_HOST=saintess.tech
OIDC_ISSUER=https://accounts.google.com
OIDC_AUDIENCE=351092985880-0k4hl1ts8vkrksenpf983ik1qjkgioh0.apps.googleusercontent.com
SPACETIMEDB_URI=wss://maincloud.spacetimedb.com
SPACETIMEDB_DATABASE=telly
FINCHNODE_MODE=api
TELLY_SECRETS_URL=https://telly-secrets.telly-keys.workers.dev/
# Only the keys this server uses with the settings above; see docs/cloudflare-keys.md.
TELLY_PULL_KEYS=GEMINI_API_KEY,ELEVENLABS_API_KEY,FINCHNODE_API_KEY,ALERT_OPERATOR_TOKEN,OIDC_CLIENT_SECRET,TELLY_R2_SECRET_ACCESS_KEY,RESEND_API_KEY,NOOP_SPACETIMEDB_TOKEN
# Private R2 bucket for report PDFs (issue #17). The access key id is public (apps/server/.env.schema).
TELLY_R2_ACCOUNT_ID=2c040ec5bc2efe34e60ab5b1b4fd2e99
TELLY_R2_BUCKET=telly-reports
TELLY_R2_ACCESS_KEY_ID=b1ef91b090d5cef55132b4303fbc05ff
